# ═══════════════════════════════════════════════════════════════════════════
# NAIL Institute — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# The .env file is gitignored — secrets never leave this machine.
# ═══════════════════════════════════════════════════════════════════════════

# ── NVIDIA NGC / NIM ──────────────────────────────────────────────────────
# Required to pull NIM containers from nvcr.io
# Get yours at: https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# ── Ollama (already running on DGX) ──────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434

# ── Optional cloud providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Canary Fleet (Phase 2 deployment) ────────────────────────────────────
# Mode: "standard" (3 agents) or "maximum" (7 agents)
CANARY_FLEET_MODE=standard
# NIM endpoint for canary LLM responses
NIM_BASE_URL=http://nim-nemotron:8000/v1/chat/completions

# ── Discord Bot (optional) ───────────────────────────────────────────────
# Get a token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Channel ID for admin incident alerts
DISCORD_ADMIN_CH=
# Comma-separated guild/server IDs
DISCORD_GUILD_IDS=
