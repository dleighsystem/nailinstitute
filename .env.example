# ═══════════════════════════════════════════════════════════════════════════
# NAIL Institute — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# The .env file is gitignored — secrets never leave this machine.
# ═══════════════════════════════════════════════════════════════════════════

# ── NVIDIA NGC / NIM ──────────────────────────────────────────────────────
# Required to pull NIM containers from nvcr.io
# Get yours at: https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# ── Ollama (already running on DGX) ──────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434

# ── Optional cloud providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
